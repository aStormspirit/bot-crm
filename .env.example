# GitHub OAuth App: https://github.com/settings/developers -> New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Любая длинная случайная строка (32+ символа), шифрует cookie сессии
SESSION_SECRET=
# Необязательно: публичный адрес приложения, например https://bot-crm.vercel.app
APP_URL=
# Рассылки (вкладка «Рассылки»): Chat API и кто может ими управлять
CHAT_API_URL=
CHAT_API_CRM_TOKEN=
# Логины GitHub через запятую
CRM_ADMINS=
# Если Chat API закрыт Cloudflare Access
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
